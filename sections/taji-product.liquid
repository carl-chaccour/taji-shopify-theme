{{ 'landing-page.css' | asset_url | stylesheet_tag }}

<style>
  .taji-product-subhead {
    font-size: 15px; font-weight: 300; color: #666;
    text-align: center; max-width: 520px;
    margin: -32px auto 56px; line-height: 1.7;
  }
  .taji-variant-price {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px; font-weight: 400;
    color: var(--black); margin-bottom: 24px;
  }
  .taji-variant-price .taji-price-original {
    font-size: 15px; color: #aaa; text-decoration: line-through;
    font-weight: 300; margin-right: 8px;
  }
  .btn-secondary.taji-cart-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  }
  .taji-cart-icon { flex-shrink: 0; }
</style>

{%- capture taji_cart_icon -%}
  <svg class="taji-cart-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>
  </svg>
{%- endcapture -%}

{%- comment -%} ======= VARIANTS / COLLECTION (same design as homepage) ======= {%- endcomment -%}
<section class="section section-white" id="taji-product-collection">
  <div class="section-inner">
    <p class="section-eyebrow">{{ section.settings.eyebrow | default: 'Choose Your Crown' | escape }}</p>
    <h2 class="section-headline serif">{{ section.settings.headline | default: 'Find Your Perfect Fit.' | escape }}</h2>
    {%- if section.settings.subhead != blank -%}
      <p class="taji-product-subhead">{{ section.settings.subhead | escape }}</p>
    {%- endif -%}

    <div class="variants-grid">

      {%- comment -%} NYLON CARD {%- endcomment -%}
      {%- assign nylon_product = section.settings.nylon_product -%}
      {%- assign has_nylon = false -%}
      {%- if nylon_product != blank -%}{%- assign has_nylon = true -%}{%- endif -%}

      <div class="variant-card">
        <div class="variant-img-box">
          {%- if section.settings.nylon_image != blank -%}
            <img src="{{ section.settings.nylon_image | image_url: width: 500 }}" alt="{{ section.settings.nylon_title | default: 'Nylon Crown' | escape }}" loading="lazy" />
          {%- elsif has_nylon and nylon_product.featured_image -%}
            <img src="{{ nylon_product.featured_image | image_url: width: 500 }}" alt="{{ nylon_product.title | escape }}" loading="lazy" />
          {%- else -%}
            <img src="{{ 'product-top.png' | asset_url }}" alt="Nylon Crown" loading="lazy" />
          {%- endif -%}
        </div>
        <p class="variant-label">{{ section.settings.nylon_label | default: 'Nylon' | escape }}</p>
        <h3 class="variant-name serif">{{ section.settings.nylon_title | default: nylon_product.title | default: 'Nylon Crown' | escape }}</h3>
        {%- if section.settings.nylon_material != blank -%}
          <p class="variant-material">{{ section.settings.nylon_material | escape }}</p>
        {%- endif -%}
        <p class="variant-desc">
          {%- if section.settings.nylon_desc != blank -%}
            {{ section.settings.nylon_desc | escape }}
          {%- elsif has_nylon -%}
            {{ nylon_product.description | strip_html | truncatewords: 26 }}
          {%- else -%}
            A firm, secure grip built for all-day wear.
          {%- endif -%}
        </p>

        {%- if has_nylon -%}
          <p class="taji-variant-price">
            {%- if nylon_product.compare_at_price > nylon_product.price -%}
              <span class="taji-price-original">{{ nylon_product.compare_at_price | money }}</span>
            {%- endif -%}
            {{ nylon_product.price | money }}
          </p>
          {%- assign nylon_variant = nylon_product.selected_or_first_available_variant -%}
          {%- form 'product', nylon_product, class: 'variant-form' -%}
            <input type="hidden" name="id" value="{{ nylon_variant.id }}" />
            <input type="hidden" name="quantity" value="1" />
            <button type="submit" class="btn-secondary taji-cart-btn">
              {{- taji_cart_icon -}}
              {{- section.settings.nylon_cta | default: 'Add to Cart' -}}
            </button>
          {%- endform -%}
        {%- else -%}
          {%- if request.design_mode -%}
            <p class="variant-no-product">No product selected — assign one in the theme editor</p>
          {%- endif -%}
          <button type="button" class="btn-secondary taji-cart-btn" disabled>
            {{- taji_cart_icon -}}
            {{- section.settings.nylon_cta | default: 'Add to Cart' -}}
          </button>
        {%- endif -%}
      </div>

      {%- comment -%} RUBBER CARD {%- endcomment -%}
      {%- assign rubber_product = section.settings.rubber_product -%}
      {%- assign has_rubber = false -%}
      {%- if rubber_product != blank -%}{%- assign has_rubber = true -%}{%- endif -%}

      <div class="variant-card">
        <div class="variant-img-box">
          {%- if section.settings.rubber_image != blank -%}
            <img src="{{ section.settings.rubber_image | image_url: width: 500 }}" alt="{{ section.settings.rubber_title | default: 'Rubber Crown' | escape }}" loading="lazy" />
          {%- elsif has_rubber and rubber_product.featured_image -%}
            <img src="{{ rubber_product.featured_image | image_url: width: 500 }}" alt="{{ rubber_product.title | escape }}" loading="lazy" />
          {%- else -%}
            <img src="{{ 'product-inside.png' | asset_url }}" alt="Rubber Crown" loading="lazy" />
          {%- endif -%}
        </div>
        <p class="variant-label">{{ section.settings.rubber_label | default: 'Rubber' | escape }}</p>
        <h3 class="variant-name serif">{{ section.settings.rubber_title | default: rubber_product.title | default: 'Rubber Crown' | escape }}</h3>
        {%- if section.settings.rubber_material != blank -%}
          <p class="variant-material">{{ section.settings.rubber_material | escape }}</p>
        {%- endif -%}
        <p class="variant-desc">
          {%- if section.settings.rubber_desc != blank -%}
            {{ section.settings.rubber_desc | escape }}
          {%- elsif has_rubber -%}
            {{ rubber_product.description | strip_html | truncatewords: 26 }}
          {%- else -%}
            A softer touch, gentle on fine or delicate hair.
          {%- endif -%}
        </p>

        {%- if has_rubber -%}
          <p class="taji-variant-price">
            {%- if rubber_product.compare_at_price > rubber_product.price -%}
              <span class="taji-price-original">{{ rubber_product.compare_at_price | money }}</span>
            {%- endif -%}
            {{ rubber_product.price | money }}
          </p>
          {%- assign rubber_variant = rubber_product.selected_or_first_available_variant -%}
          {%- form 'product', rubber_product, class: 'variant-form' -%}
            <input type="hidden" name="id" value="{{ rubber_variant.id }}" />
            <input type="hidden" name="quantity" value="1" />
            <button type="submit" class="btn-secondary taji-cart-btn">
              {{- taji_cart_icon -}}
              {{- section.settings.rubber_cta | default: 'Add to Cart' -}}
            </button>
          {%- endform -%}
        {%- else -%}
          {%- if request.design_mode -%}
            <p class="variant-no-product">No product selected — assign one in the theme editor</p>
          {%- endif -%}
          <button type="button" class="btn-secondary taji-cart-btn" disabled>
            {{- taji_cart_icon -}}
            {{- section.settings.rubber_cta | default: 'Add to Cart' -}}
          </button>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "TAJI Product Bundles",
  "tag": "div",
  "class": "taji-product-bundles-page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Choose Your Crown" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Find Your Perfect Fit." },
    { "type": "textarea", "id": "subhead", "label": "Subheading", "default": "Every TAJI crown is engineered for all-day grip. Choose the variant that works best for your hair type." },

    {
      "type": "header",
      "content": "Nylon Crown"
    },
    {
      "type": "product",
      "id": "nylon_product",
      "label": "Nylon product",
      "info": "Price, description, image, and Add to Cart sync automatically from this product."
    },
    { "type": "image_picker", "id": "nylon_image", "label": "Card image (overrides product image)" },
    { "type": "text", "id": "nylon_label", "label": "Card label", "default": "Nylon" },
    { "type": "text", "id": "nylon_title", "label": "Card title (overrides product title)" },
    { "type": "text", "id": "nylon_material", "label": "Material tagline", "default": "PA12 — Smooth Grip" },
    { "type": "textarea", "id": "nylon_desc", "label": "Description (overrides product description)" },
    { "type": "text", "id": "nylon_cta", "label": "Button text", "default": "Add to Cart" },

    {
      "type": "header",
      "content": "Rubber Crown"
    },
    {
      "type": "product",
      "id": "rubber_product",
      "label": "Rubber product",
      "info": "Price, description, image, and Add to Cart sync automatically from this product."
    },
    { "type": "image_picker", "id": "rubber_image", "label": "Card image (overrides product image)" },
    { "type": "text", "id": "rubber_label", "label": "Card label", "default": "Rubber" },
    { "type": "text", "id": "rubber_title", "label": "Card title (overrides product title)" },
    { "type": "text", "id": "rubber_material", "label": "Material tagline", "default": "TPEE — Soft Grip" },
    { "type": "textarea", "id": "rubber_desc", "label": "Description (overrides product description)" },
    { "type": "text", "id": "rubber_cta", "label": "Button text", "default": "Add to Cart" }
  ],
  "presets": [
    { "name": "TAJI Product Bundles" }
  ]
}
{% endschema %}
