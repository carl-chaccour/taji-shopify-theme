{{ 'landing-page.css' | asset_url | stylesheet_tag }}

{%- assign taji_about_url = '/pages/about' -%}
{%- assign taji_contact_url = '/pages/contact' -%}
{%- assign taji_faq_url = '/pages/faq' -%}
{%- assign taji_terms_url = section.settings.footer_terms_url -%}
{%- assign taji_refund_url = section.settings.footer_refund_url -%}
{%- assign taji_shipping_url = section.settings.footer_shipping_url -%}
{%- for p in pages -%}
  {%- if p.template_suffix == 'about' -%}{%- assign taji_about_url = p.url -%}{%- endif -%}
  {%- if p.template_suffix == 'contact-taji' -%}{%- assign taji_contact_url = p.url -%}{%- endif -%}
  {%- if p.template_suffix == 'faq' -%}{%- assign taji_faq_url = p.url -%}{%- endif -%}
  {%- if p.template_suffix == 'terms' -%}{%- assign taji_terms_url = p.url -%}{%- endif -%}
  {%- if p.template_suffix == 'refund' -%}{%- assign taji_refund_url = p.url -%}{%- endif -%}
  {%- if p.template_suffix == 'shipping' -%}{%- assign taji_shipping_url = p.url -%}{%- endif -%}
{%- endfor -%}
{%- assign nav_url_1 = section.settings.nav_link_1_url | default: '/' -%}
{%- assign nav_url_2 = section.settings.nav_link_2_url | default: '/pages/products' -%}
{%- assign nav_url_3 = section.settings.nav_link_3_url | default: taji_about_url -%}
{%- assign nav_url_4 = section.settings.nav_link_4_url | default: taji_contact_url -%}
{%- assign nav_url_5 = section.settings.nav_link_5_url | default: taji_faq_url -%}

<footer>
  <div class="footer-inner">
    <div class="footer-top">
      <div>
        {%- if section.settings.nav_logo != blank -%}
          <img
            src="{{ section.settings.nav_logo | image_url: width: 160 }}"
            alt="{{ shop.name }}"
            class="footer-logo"
          />
        {%- else -%}
          <img src="{{ 'taji-logo.png' | asset_url }}" alt="{{ shop.name }}" class="footer-logo" />
        {%- endif -%}
        {%- if section.settings.footer_arabic != blank -%}
          <p class="footer-brand-arabic">{{ section.settings.footer_arabic | escape }}</p>
        {%- endif -%}
        {%- if section.settings.footer_tagline != blank -%}
          <p class="footer-brand-tagline">{{ section.settings.footer_tagline | escape }}</p>
        {%- endif -%}
      </div>
      <div>
        <p class="footer-col-title">{{ section.settings.footer_links_title | default: 'Quick Links' | escape }}</p>
        <ul class="footer-col-links">
          {%- if section.settings.nav_link_1_label != blank -%}
            <li><a href="{{ nav_url_1 }}">{{ section.settings.nav_link_1_label | escape }}</a></li>
          {%- endif -%}
          {%- if section.settings.nav_link_2_label != blank -%}
            <li><a href="{{ nav_url_2 }}">{{ section.settings.nav_link_2_label | escape }}</a></li>
          {%- endif -%}
          {%- if section.settings.nav_link_3_label != blank -%}
            <li><a href="{{ nav_url_3 }}">{{ section.settings.nav_link_3_label | escape }}</a></li>
          {%- endif -%}
          {%- if section.settings.nav_link_4_label != blank -%}
            <li><a href="{{ nav_url_4 }}">{{ section.settings.nav_link_4_label | escape }}</a></li>
          {%- endif -%}
          {%- if section.settings.nav_link_5_label != blank -%}
            <li><a href="{{ nav_url_5 }}">{{ section.settings.nav_link_5_label | escape }}</a></li>
          {%- endif -%}
          {%- if section.settings.nav_shop_btn_text != blank -%}
            <li><a href="{{ section.settings.nav_shop_btn_url | default: nav_url_2 }}">{{ section.settings.nav_shop_btn_text | escape }}</a></li>
          {%- endif -%}
        </ul>
      </div>
      <div>
        <p class="footer-col-title">{{ section.settings.footer_legal_title | default: 'Legal' | escape }}</p>
        <ul class="footer-col-links">
          {%- if taji_terms_url != blank -%}
            <li><a href="{{ taji_terms_url }}">{{ section.settings.footer_terms_label | default: 'Terms of Service' | escape }}</a></li>
          {%- endif -%}
          {%- if section.settings.footer_privacy_url != blank -%}
            <li><a href="{{ section.settings.footer_privacy_url }}">{{ section.settings.footer_privacy_label | default: 'Privacy Policy' | escape }}</a></li>
          {%- endif -%}
          {%- if taji_refund_url != blank -%}
            <li><a href="{{ taji_refund_url }}">{{ section.settings.footer_refund_label | default: 'Refund Policy' | escape }}</a></li>
          {%- endif -%}
          {%- if taji_shipping_url != blank -%}
            <li><a href="{{ taji_shipping_url }}">{{ section.settings.footer_shipping_label | default: 'Shipping Policy' | escape }}</a></li>
          {%- endif -%}
        </ul>
      </div>
      <div>
        <p class="footer-col-title">{{ section.settings.footer_contact_title | default: 'Contact Us' | escape }}</p>
        {%- if section.settings.footer_email != blank -%}
          <div class="footer-contact-line">
            <span class="footer-contact-icon" aria-hidden="true">✉</span>
            <p class="footer-contact-text">
              <a href="mailto:{{ section.settings.footer_email }}">{{ section.settings.footer_email | escape }}</a>
            </p>
          </div>
        {%- endif -%}
        {%- if section.settings.footer_instagram_label != blank -%}
          <div class="footer-contact-line">
            <span class="footer-contact-icon" aria-hidden="true">✦</span>
            <p class="footer-contact-text">
              <a href="{{ section.settings.footer_instagram_url | default: '#' }}">{{ section.settings.footer_instagram_label | escape }}</a>
            </p>
          </div>
        {%- endif -%}
        {%- if section.settings.footer_location != blank -%}
          <div class="footer-contact-line">
            <span class="footer-contact-icon" aria-hidden="true">◎</span>
            <p class="footer-contact-text">{{ section.settings.footer_location | escape }}</p>
          </div>
        {%- endif -%}
        {%- if section.settings.footer_response_time != blank -%}
          <div class="footer-contact-line">
            <span class="footer-contact-icon" aria-hidden="true">◷</span>
            <p class="footer-contact-text">{{ section.settings.footer_response_time | escape }}</p>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.footer_newsletter_enable -%}
    <div class="footer-newsletter">
      <p class="footer-newsletter-heading serif">{{ section.settings.footer_newsletter_heading | default: 'Subscribe to Our Emails' | escape }}</p>
      {%- form 'customer', id: 'TajiFooterNewsletter', class: 'footer-newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="footer-newsletter-success">✓ {{ section.settings.footer_newsletter_success | default: "Thanks for subscribing!" | escape }}</p>
        {%- else -%}
          <div class="footer-newsletter-field">
            <input
              type="email"
              name="contact[email]"
              id="TajiFooterNewsletter-email"
              placeholder="{{ 'newsletter.label' | t }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="footer-newsletter-submit" aria-label="{{ 'newsletter.button_label' | t }}">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
              </svg>
            </button>
          </div>
          {%- if form.errors -%}
            <p class="footer-newsletter-error">{{ form.errors.messages.email }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
    {%- endif -%}

    <div class="footer-bottom">
      <p class="footer-copy">{{ section.settings.footer_copy | default: '© 2025 TAJI. All rights reserved.' | escape }}</p>
      <div class="footer-social">
        {%- if section.settings.footer_instagram_url != blank -%}
          <a href="{{ section.settings.footer_instagram_url }}">Instagram</a>
        {%- endif -%}
        {%- if section.settings.footer_whatsapp_url != blank -%}
          <a href="{{ section.settings.footer_whatsapp_url }}">WhatsApp</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "TAJI Footer",
  "settings": [
    { "type": "image_picker", "id": "nav_logo", "label": "Logo image" },
    { "type": "text", "id": "nav_shop_btn_text", "label": "Shop button label", "default": "Shop Now" },
    { "type": "url", "id": "nav_shop_btn_url", "label": "Shop button URL" },
    { "type": "text", "id": "nav_link_1_label", "label": "Nav link 1 label", "default": "Home" },
    { "type": "url", "id": "nav_link_1_url", "label": "Nav link 1 URL" },
    { "type": "text", "id": "nav_link_2_label", "label": "Nav link 2 label", "default": "Products" },
    { "type": "url", "id": "nav_link_2_url", "label": "Nav link 2 URL" },
    { "type": "text", "id": "nav_link_3_label", "label": "Nav link 3 label", "default": "About Us" },
    { "type": "url", "id": "nav_link_3_url", "label": "Nav link 3 URL" },
    { "type": "text", "id": "nav_link_4_label", "label": "Nav link 4 label", "default": "Contact" },
    { "type": "url", "id": "nav_link_4_url", "label": "Nav link 4 URL" },
    { "type": "text", "id": "nav_link_5_label", "label": "Nav link 5 label", "default": "FAQ" },
    { "type": "url", "id": "nav_link_5_url", "label": "Nav link 5 URL" },
    { "type": "text", "id": "footer_arabic", "label": "Footer Arabic text" },
    { "type": "text", "id": "footer_tagline", "label": "Footer tagline", "default": "The hijab grip crown designed for women who refuse to be distracted. Made in Lebanon." },
    { "type": "text", "id": "footer_links_title", "label": "Quick Links title", "default": "Quick Links" },
    { "type": "text", "id": "footer_legal_title", "label": "Legal title", "default": "Legal" },
    { "type": "text", "id": "footer_terms_label", "label": "Terms label", "default": "Terms of Service" },
    { "type": "url", "id": "footer_terms_url", "label": "Terms URL (fallback if no custom Terms page found)" },
    { "type": "text", "id": "footer_privacy_label", "label": "Privacy label", "default": "Privacy Policy" },
    { "type": "url", "id": "footer_privacy_url", "label": "Privacy URL", "default": "/policies/privacy-policy" },
    { "type": "text", "id": "footer_refund_label", "label": "Refund label", "default": "Refund Policy" },
    { "type": "url", "id": "footer_refund_url", "label": "Refund URL (fallback if no custom Refund page found)" },
    { "type": "text", "id": "footer_shipping_label", "label": "Shipping label", "default": "Shipping Policy" },
    { "type": "url", "id": "footer_shipping_url", "label": "Shipping URL (fallback if no custom Shipping page found)" },
    { "type": "text", "id": "footer_contact_title", "label": "Contact title", "default": "Contact Us" },
    { "type": "text", "id": "footer_email", "label": "Contact email", "default": "info@taji-lb.com" },
    { "type": "url", "id": "footer_instagram_url", "label": "Instagram URL" },
    { "type": "text", "id": "footer_instagram_label", "label": "Instagram label", "default": "Instagram" },
    { "type": "text", "id": "footer_location", "label": "Location text", "default": "Lebanon — nationwide delivery" },
    { "type": "text", "id": "footer_response_time", "label": "Response time text", "default": "We reply within 24 hours" },
    { "type": "url", "id": "footer_whatsapp_url", "label": "WhatsApp URL" },
    { "type": "text", "id": "footer_copy", "label": "Copyright text", "default": "© 2025 TAJI. All rights reserved." },
    { "type": "checkbox", "id": "footer_newsletter_enable", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "footer_newsletter_heading", "label": "Newsletter heading", "default": "Subscribe to Our Emails" },
    { "type": "text", "id": "footer_newsletter_success", "label": "Newsletter success message", "default": "Thanks for subscribing!" }
  ]
}
{% endschema %}
